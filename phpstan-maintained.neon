# Analyze every maintained PHP file without exposing development symbols to the
# separate production profile. New roots and split files are included by default.
parameters:
	level: 8
	treatPhpDocTypesAsCertain: false
	paths:
		- .
	excludePaths:
		analyseAndScan:
			- vendor/*
			- node_modules/*
			- .git/*
			- .workspaces/*
